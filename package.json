{
  "name": "japanese-data-agent",
  "version": "0.1.0",
  "description": "A reproducible Japanese NL-to-SQL harness using your own Claude API key",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "node --env-file=.env.local node_modules/@playwright/test/cli.js test --config=playwright.live.config.ts",
    "db:up": "docker compose up -d --wait",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "ask": "tsx --env-file=.env.local scripts/ask.ts",
    "eval": "tsx --env-file=.env.local scripts/eval.ts",
    "eval:conversations": "tsx --env-file=.env.local scripts/eval-conversations.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.79",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "ai": "^7.0.138",
    "lucide-react": "^1.50.0",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "pgsql-parser": "^18.2.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "private": true
}
