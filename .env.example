# demo needs no API key or database. live never falls back to demo.
AGENT_MODE=demo
ANTHROPIC_API_KEY=
# Set an available Claude model ID for your own account.
ANTHROPIC_MODEL=
# Local-only fictional database. Replace credentials outside local development.
DATABASE_URL=postgresql://analyst:analyst_local_only@127.0.0.1:54324/analytics
ADMIN_DATABASE_URL=postgresql://postgres:postgres_local_only@127.0.0.1:54324/analytics
# Optional: USD per million tokens and JPY/USD. Empty means cost is unmeasured.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
JPY_PER_USD=
# Required for exposing live mode. Client uses this token, never the Claude key.
AGENT_ACCESS_TOKEN=
